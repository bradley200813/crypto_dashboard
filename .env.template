# Environment Variables Template for Production
# Copy this file to .env and configure the values for your deployment

# Security
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False

# Database (PostgreSQL recommended for production)
# DB_NAME=cryptotracker
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# API Keys
NEWS_API_KEY=your-newsapi-org-key-here

# Cache (Redis recommended for production)
# USE_REDIS=true
# REDIS_URL=redis://127.0.0.1:6379/1

# Email Configuration (optional - for password resets)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@cryptotracker.com

# Allowed Hosts (update with your domain)
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com